{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/.vinext/",
    "**/.cloudflare/",
    "**/.wrangler/",
    "**/next-env.d.ts",
    "**/*.tsbuildinfo",
    "**/*.md"
  ]
}
