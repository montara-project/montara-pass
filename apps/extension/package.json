{
  "name": "@montara-pass/extension",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "watch": "wxt",
    "watch:firefox": "wxt -b firefox",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:ce": "VITE_EDITION=community pnpm run build",
    "clean": "rimraf dist",
    "prezip": "pnpm run clean && pnpm run build",
    "zip": "pnpm run zip:chrome && pnpm run zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@montara-pass/shared": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "input-otp": "1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "rimraf": "6.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
