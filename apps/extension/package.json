{
  "name": "@montara-pass/extension",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "watch": "TARGET=chrome vite build --watch --mode development",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "TARGET=chrome vite build",
    "build:firefox": "TARGET=firefox vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
