# Defaults baked into the build. Without this file `pnpm watch` (development
# mode) uses the two below and `pnpm build` uses https://app.montarapass.com
# for both. In development mode the popup's settings can change both; in a
# production build they offer one Server URL, for a self-hosted server.
VITE_DEFAULT_API_URL=http://localhost:8080
VITE_DEFAULT_APP_URL=http://localhost:5173
