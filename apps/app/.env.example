VITE_APP_NAME=Montara Pass
# Origin of the Go API (apps/server). Leave it empty: in development Vite
# proxies /api to http://localhost:8080, and in production the API serves this
# app itself, so both share one origin. Set it only when the API lives on
# another origin, which must then list this app in its CORS_ALLOWED_ORIGINS.
VITE_API_URL=
