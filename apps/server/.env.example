# App
# Debug logging prints every auth query with its values, password hashes
# included; it is refused when ENV=production.
DEBUG=false
# development, staging or production. Unset means production; only
# development relaxes the session cookie and the loopback rate limit.
ENV=development
PORT=8080
APP_NAME=montara-pass
# At least 32 characters: openssl rand -base64 32
APP_SECRET=

# Super user created on boot when SEED_ON_BOOT=true, as email:password.
# The password must be 12 to 128 characters, so replace this one. Changing it
# resets the account's password on the next seeded boot.
SUPER_USER=admin@mail.com:admin123

# Comma-separated browser origins allowed to call the API cross-origin.
# Empty disables CORS (same-origin only), which is enough for the web app: the
# API serves it in production and the Vite dev server proxies /api to it.
CORS_ALLOWED_ORIGINS=

# Apply embedded migrations when the API boots
MIGRATE_ON_BOOT=true
# Run the idempotent seeders when the API boots (needs SUPER_USER)
SEED_ON_BOOT=false

# PostgreSQL 18+ (the migrations use uuidv7())
DB_DSN=postgres://montara:montara@localhost:5432/montara_pass?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Auth (Authula, mounted at /api/v1/auth). APP_SECRET also signs Authula tokens.
# Public URL of this API, used in email links and the Google callback;
# empty defaults to http://localhost:$PORT.
AUTH_BASE_URL=http://localhost:8080

# Resend sender (must be a verified domain) and API key. Required in the
# Cloud Edition; the Community Edition may leave both empty, which turns off
# password reset and magic-link sign-in (change SUPER_USER to reset).
FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=

# Google OAuth client; empty disables Google sign-in. Authorized redirect URI:
# $AUTH_BASE_URL/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Shared by the rate limiter and the idempotency keys, so every
# replica counts and remembers the same. Empty keeps them in this process's
# memory, which is enough for one instance.
REDIS_URL=

# Cloud Edition billing through Lemon Squeezy: an API key (a test-mode key
# for the store's test mode), the store's numeric id, and the signing secret
# of its webhook. All three or none; empty leaves checkout off, and the plans
# are still listed. Point the webhook at
# $AUTH_BASE_URL/api/v1/billing/lemonsqueezy/webhook with the events
# order_created, order_refunded, subscription_created and subscription_updated.
# The plans are the store's catalog: one per variant, at its price, synced on
# boot, every 15 minutes, and by a super user's POST /api/v1/plans/sync. Each
# new account is saved as a customer of the store.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Sharing an item needs a paid plan. Needs LEMONSQUEEZY_API_KEY, and boot
# refuses it without one, so a missing key never makes sharing free unnoticed.
REQUIRE_PAID_SHARING=false

SENTRY_DSN=
