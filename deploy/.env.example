# Environment for deploy/docker-compose.yml. In Dokploy, paste this into the
# Compose service's Environment tab and fill in the empty values.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=montara
# Goes into a connection URL: letters, digits, - and _ only.
POSTGRES_PASSWORD=
POSTGRES_DB=montara_pass

# --- Server -----------------------------------------------------------------
# At least 32 characters: openssl rand -base64 32
APP_SECRET=
# The public URL of the deployment, without a trailing slash,
# e.g. https://pass.example.com
AUTH_BASE_URL=

# Resend sender (a verified domain) and API key, for the sign-in emails.
# Required with EDITION=cloud. EDITION=community may leave both empty, which
# turns off password reset and magic-link sign-in (change SUPER_USER instead).
FROM_ADDRESS=
RESEND_API_KEY=

# Optional: create a super user on boot, as email:password (12 to 128
# characters). Set SEED_ON_BOOT back to false once the account exists.
# Required with EDITION=community: keep SEED_ON_BOOT=true, the super user is the
# Community Edition's only account.
SEED_ON_BOOT=false
SUPER_USER=

# Optional: Google sign-in. Authorized redirect URI:
# $AUTH_BASE_URL/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, Cloud Edition: billing through Lemon Squeezy. An API key (a
# test-mode key for the store's test mode), the store's numeric id, and the
# signing secret of its webhook. All three or none; empty leaves checkout off, and the plans
# are still listed. Point the webhook at
# $AUTH_BASE_URL/api/v1/billing/lemonsqueezy/webhook with the events
# order_created, order_refunded, subscription_created and subscription_updated.
# The plans are the store's catalog: one per variant, at its price, synced on
# boot, every 15 minutes, and by a super user's POST /api/v1/plans/sync. Each
# new account is saved as a customer of the store.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Sharing an item needs a paid plan. Needs LEMONSQUEEZY_API_KEY; the server
# refuses to start without it.
REQUIRE_PAID_SHARING=false

# Optional
SENTRY_DSN=
# COMPOSE_PROFILES=docs

# Optional: community builds the Community Edition (one user, no sign-up, no
# sharing); cloud, the default, the Cloud Edition. Baked in at build time.
# EDITION=cloud

# Optional: the version /api/health reports, baked in at build time.
# APP_VERSION=v1.0.0
