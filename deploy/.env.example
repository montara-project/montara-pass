# Environment for deploy/docker-compose.yml. In Dokploy, paste this into the
# Compose service's Environment tab and fill in the empty values.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=montara
# Goes into a connection URL: letters, digits, - and _ only.
POSTGRES_PASSWORD=
POSTGRES_DB=montara_pass

# --- Server -----------------------------------------------------------------
# At least 32 characters: openssl rand -base64 32
APP_SECRET=
# The public URL of the deployment, without a trailing slash,
# e.g. https://pass.example.com
AUTH_BASE_URL=

# Resend sender (a verified domain) and API key, for the sign-in emails.
FROM_ADDRESS=
RESEND_API_KEY=

# Optional: create a super user on boot, as email:password (12 to 128
# characters). Set SEED_ON_BOOT back to false once the account exists.
# Required with EDITION=ce: keep SEED_ON_BOOT=true, the super user is the
# Community Edition's only account.
SEED_ON_BOOT=false
SUPER_USER=

# Optional: Google sign-in. Authorized redirect URI:
# $AUTH_BASE_URL/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, Enterprise Edition: Midtrans takes the payments for plans. Empty
# leaves checkout off. Set the dashboard's Payment Notification URL to
# $AUTH_BASE_URL/api/v1/billing/midtrans/notification.
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Optional
SENTRY_DSN=
# COMPOSE_PROFILES=docs

# Optional: ce builds the Community Edition (one user, no sign-up, no
# sharing); ee, the default, the Enterprise Edition. Baked in at build time.
# EDITION=ee

# Optional: the version /api/health reports, baked in at build time.
# APP_VERSION=v1.0.0
